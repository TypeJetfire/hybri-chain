#!/usr/bin/env bpftrace
//===============================================================================
// trace_ollama.bt - Ollama eBPF 追踪脚本（轻量版）
//
// 只使用 tracepoint，不使用 uprobe，保证服务不被打死。
// uprobe 版本见 trace_ollama_full.bt
//
// 使用方法:
//   bpftrace -p <PID> -o trace_output.log trace_ollama.bt
//===============================================================================

// ========== 配置 ==========
#define WINDOW_MS  5000
#define MIN_MMAP   1048576
#define MIN_READ   1024

// ========== Part 1: 线程创建（daemon fork runner 子进程）==========
// 每次 daemon 启动新推理请求时会 fork，追踪这个就知道请求处理线程是谁

tracepoint:sched:sched_process_fork
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    printf("[FORK]     %s.%06d parent_pid=%d child_pid=%d comm=%s\n",
           strftime("%H:%M:%S", $ts), $us,
           args->parent_pid, args->child_pid, comm);
}

// ========== Part 2: 可执行文件加载（runner 进程加载模型文件）==========
// 推理开始时 runner 进程会用 execve 加载 GGML 库

tracepoint:syscalls:sys_enter_execve
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $fn = str(args->filename);
    // 过滤 ollama 相关路径
    if ($fn =~ ".*ollama.*" || $fn =~ ".*llama.*" || $fn =~ ".*ggml.*") {
        printf("[EXECVE]   %s.%06d pid=%d tid=%d file=%s\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid, $fn);
    }
}

// ========== Part 3: mmap（模型加载、KV cache 分配）==========
// 大于 1MB 的 mmap 才记录（过滤 Go runtime 的小块分配）

tracepoint:syscalls:sys_enter_mmap
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $len = args->len;
    if ($len >= MIN_MMAP) {
        printf("[MMAP-ENT] %s.%06d pid=%d tid=%d len=%dKB prot=0x%x\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid,
               $len / 1024, args->prot);
    }
}

tracepoint:syscalls:sys_exit_mmap
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $ret = args->ret;
    if ($ret != 0) {
        // 成功映射的地址（大于 0x100000 排除 MAP_FAILED）
        if ($ret > 0x100000) {
            printf("[MMAP-EXT] %s.%06d pid=%d tid=%d addr=0x%x\n",
                   strftime("%H:%M:%S", $ts), $us, pid, tid, $ret);
        }
    }
}

// ========== Part 4: openat（文件访问：模型文件 GGUF、权重块 blobs）==========
// 只记录 30 秒窗口内的文件访问（减少噪音）

BEGIN
{
    @start_ns = nsecs;
}

tracepoint:syscalls:sys_enter_openat
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $fn = str(args->filename);

    // 过滤 ollama 相关路径（模型文件、GGML 库）
    if ($fn =~ ".*\\.ollama.*" || $fn =~ ".*llama.*" ||
        $fn =~ ".*qwen.*"      || $fn =~ ".*ggml.*" ||
        $fn =~ ".*gguf.*"      || $fn =~ ".*blob.*") {
        $elapsed = ($ts - @start_ns) / 1000000;
        printf("[OPENAT]   %s.%06d pid=%d tid=%d dfd=%d flags=0x%x path=%s\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid,
               args->dfd, args->flags, $fn);
    }
}

// ========== Part 5: read（大块读取：模型权重、blobs）==========

tracepoint:syscalls:sys_enter_read
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $cnt = args->count;
    if ($cnt >= MIN_READ) {
        printf("[READ-ENT] %s.%06d pid=%d tid=%d fd=%d count=%d\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid,
               args->fd, $cnt);
    }
}

tracepoint:syscalls:sys_exit_read
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $ret = args->ret;
    if ($ret >= MIN_READ) {
        printf("[READ-EXT] %s.%06d pid=%d tid=%d ret=%d\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid, $ret);
    }
}

// ========== Part 6: clone3 / 线程创建 ==========

tracepoint:syscalls:sys_exit_clone3
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $ret = args->ret;
    if ($ret > 0) {
        printf("[CLONE3]   %s.%06d parent_pid=%d new_pid=%d stack_size=%d\n",
               strftime("%H:%M:%S", $ts), $us, pid, $ret, args->stack);
    }
}

// ========== Part 7: munmap（内存释放）==========

tracepoint:syscalls:sys_enter_munmap
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    $len = args->length;
    if ($len >= MIN_MMAP) {
        printf("[MUNMAP]   %s.%06d pid=%d tid=%d addr=0x%x len=%dKB\n",
               strftime("%H:%M:%S", $ts), $us, pid, tid,
               args->addr, $len / 1024);
    }
}

// ========== Part 8: 定时心跳（每 10 秒打印分隔线）==========

interval:s:10
{
    $ts = nsecs; $us = ($ts % 1000000000) / 1000;
    printf("\n=== %s (elapsed %ds) ===\n",
           strftime("%H:%M:%S", $ts), (nsecs - @start_ns) / 1000000000);
}

// ========== 退出时清理 ==========

end
{
    clear(@start_ns);
    printf("\n[TRACE END]\n");
}
