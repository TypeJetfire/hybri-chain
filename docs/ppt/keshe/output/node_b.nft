# nftables policy for node: node_b
# Generated by TrivialTier Policy Generator
# Note: Rules filter traffic by source IP from WireGuard network
# You may want to add interface filtering (e.g., iifname "wg0") for tighter control

# Flush existing table (if exists)
nft flush table inet wireguard_policy 2>/dev/null || true
nft delete table inet wireguard_policy 2>/dev/null || true

table inet wireguard_policy {
    chain input {
        type filter hook input priority filter; policy drop;
        # Allow loopback
        iif lo accept
        # Allow established and related connections
        ct state established,related accept

        # Allow TCP ports 22,80,443 from node_a (10.0.0.1)
        ip saddr 10.0.0.1 tcp dport { 22,80,443 } accept
        # Allow UDP ports 53 from node_a (10.0.0.1)
        ip saddr 10.0.0.1 udp dport { 53 } accept
        # Allow ICMP from node_a (10.0.0.1)
        ip saddr 10.0.0.1 icmp type echo-request accept
        ip saddr 10.0.0.1 icmp type echo-reply accept

        # Default drop (already set by policy)
    }

    chain output {
        type filter hook output priority filter; policy accept;
        # Allow all outbound traffic
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # Default drop for forwarding
    }
}
